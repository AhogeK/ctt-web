{
  "name": "ctt-web",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "test:unit": "vp test",
    "test:e2e": "playwright test",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "vp lint . --fix",
    "lint:eslint": "vp lint . --fix",
    "format": "vp fmt --write src/",
    "format:check": "vp fmt --check src/",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/vue": "^5.0.1",
    "@lucide/vue": "1.28.0",
    "@tanstack/vue-query": "^5.101.4",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "nprogress": "^0.2.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vee-validate": "^4.15.1",
    "vue": "beta",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "11.4.8",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@faker-js/faker": "^10.5.0",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.26",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.77.0",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "npm-run-all2": "^9.0.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plus": "0.2.8",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "src/**/*.{ts,js,vue,tsx,jsx}": [
      "vp fmt",
      "vp lint --fix"
    ],
    "{src/**/__tests__/*,e2e/**/*.spec}.{ts,js}": [
      "vp lint --fix",
      "vp fmt"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  }
}
