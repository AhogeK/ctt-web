.playwright-mcp/

test-results/
playwright-report/

# Test artifacts
src/__tests__/*.d.ts
src/__tests__/*.js
.gstack/
.vite-hooks/
.sisyphus/
.omo/

# AI agent workspaces (R16 protection)
.agents/
.claude/
.opencode/
# AI tooling is versioned so it survives across sessions and machines;
# everything else under .omp/ stays out of the repo.
.omp/*

# Skills lock cache (regenerable)
skills-lock.fast-update-cache.json

# Obsidian's per-vault configuration, written the moment a reader opens a note here. It is
# editor state, not content: committing it would put a plugin bundle under lint and review.
.plans/.obsidian/

# Editor/tooling backups. A backup of a tracked file is never repository content: the tracked file
# is the truth, and the .bak is how a tool says "I was about to overwrite something". Gitignored
# rather than deleted, so a tool that re-creates one cannot leave the tree permanently dirty.
*.bak

